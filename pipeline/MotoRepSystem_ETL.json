				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select dp.id,\n\t\tc.Nombre AS Categoria,\n\t\tp.Nombre AS Producto,\n\t\tm.Nombre AS Marca,\n\t\tmm.Nombre AS MotoMarca,\n\t\tmo.Modelo AS Moto,\n\t\tISNULL(cp.Color, '') AS Color,\n\t\tISNULL(sz.Tamaño, '') AS Tamaño\n\t\t\n\t\t\n\nfrom producto_detalleproductos AS dp\nINNER JOIN producto_productos AS p ON dp.producto_id = p.id\nINNER JOIN marca_marcas AS m ON dp.MarcaId_id = m.id\nINNER JOIN moto_motos AS mo ON dp.MotoId_id = mo.id\nINNER JOIN categoria_categorias AS c ON p.CategoriaId_id = c.id\nLEFT JOIN ColorProducto_colorproducto AS cp ON dp.ColorId_id = cp.id\nLEFT JOIN size_size AS sz ON dp.size_id = sz.id\nINNER JOIN marca_marcas AS mm ON mo.MarcaId_id = mm.id",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "upsert",
						"upsertSettings": {
							"useTempDB": true,
							"keys": [
								"ProductoID"
							]
						},
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
