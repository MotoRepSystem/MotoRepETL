									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "Producto",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "Producto",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "Categoria",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "Categoria",
									"type": "String",
									"physicalType": "varchar"
								}
							},
