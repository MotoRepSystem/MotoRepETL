			{
				"name": "DimTiempo",
				"description": "Carga de datos de la dimensión Tiempo",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "NEW_MotoRepDW",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "SET LANGUAGE Español;\n\nDECLARE @StartDate DATE = '2021-06-15';\nDECLARE @EndDate DATE = '2026-11-01';\n\nWITH ListaFechas AS (\n    SELECT @StartDate AS Fecha\n    UNION ALL\n    SELECT DATEADD(day, 1, Fecha)\n    FROM ListaFechas\n    WHERE Fecha < @EndDate\n)\n\nINSERT INTO DimTiempo (id, Fecha, Year, Mes, NombreMes, Trimestre, Dia, NombreDia)\nSELECT\n    YEAR(Fecha) * 10000 + MONTH(Fecha) * 100 + DAY(Fecha),\n    Fecha,\n    YEAR(Fecha),\n    MONTH(Fecha),\n    DATENAME(month, Fecha),\n    DATEPART(quarter, Fecha),\n    DAY(Fecha),\n    DATENAME(weekday, Fecha)\nFROM ListaFechas AS L\nWHERE NOT EXISTS (\n    SELECT 1 \n    FROM DimTiempo AS T \n    WHERE T.id = YEAR(L.Fecha) * 10000 + MONTH(L.Fecha) * 100 + DAY(L.Fecha)\n)\nOPTION (MAXRECURSION 0);"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
