{
	"name": "MotoRepApp_ETL",
	"properties": {
		"activities": [
			{
				"name": "OrigenEncuesta",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "clientes"
					},
					{
						"name": "Destination",
						"value": "dbo.StgEncuestaSatisfaccion"
					}
				],
				"typeProperties": {
					"source": {
						"type": "CosmosDbMongoDbApiSource",
						"batchSize": 100
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['_id']['$oid']"
								}
							},
							{
								"source": {
									"path": "$['cliente_id']"
								}
							},
							{
								"source": {
									"path": "$['factura_id']"
								}
							},
							{
								"source": {
									"path": "$['fecha_encuesta']"
								}
							},
							{
								"source": {
									"path": "$['satisfaccion_servicio']['satisfaccion_general']"
								}
							},
							{
								"source": {
									"path": "$['satisfaccion_servicio']['atencion_personal']"
								}
							},
							{
								"source": {
									"path": "$['satisfaccion_servicio']['experiencia_compra']"
								}
							},
							{
								"source": {
									"path": "$['preferencias_uso']['facilidad_encontrar_producto']"
								}
							},
							{
								"source": {
									"path": "$['preferencias_uso']['variedad_productos']"
								}
							},
							{
								"source": {
									"path": "$['preferencias_uso']['marca_preferida']"
								}
							},
							{
								"source": {
									"path": "$['productos_frecuentes'][0]"
								}
							},
							{
								"source": {
									"path": "$['comentario_servicio']"
								}
							},
							{
								"source": {
									"path": "$['comentario_mejora']"
								}
							}
						],
						"collectionReference": "",
						"mapComplexValuesToString": false
					}
				},
				"inputs": [
					{
						"referenceName": "Origen_Encuesta",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "TBL_TEMP_Encuesta",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}