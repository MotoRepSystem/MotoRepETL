{
	"name": "DFT_FactVenta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "O_FactVenta",
						"type": "DatasetReference"
					},
					"name": "FactVenta"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo"
				},
				{
					"dataset": {
						"referenceName": "D_DimCliente",
						"type": "DatasetReference"
					},
					"name": "DimCliente"
				},
				{
					"dataset": {
						"referenceName": "D_DimCondicionPago",
						"type": "DatasetReference"
					},
					"name": "DimCondicionPago"
				},
				{
					"dataset": {
						"referenceName": "D_DimEmpleado",
						"type": "DatasetReference"
					},
					"name": "DimEmpleado"
				},
				{
					"dataset": {
						"referenceName": "D_DimProducto",
						"type": "DatasetReference"
					},
					"name": "DimProducto"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "D_FactVenta",
						"type": "DatasetReference"
					},
					"name": "DestinoFactVenta"
				}
			],
			"transformations": [
				{
					"name": "DataConversion"
				},
				{
					"name": "LookupDimTiempo"
				},
				{
					"name": "Limpieza1"
				},
				{
					"name": "LookupDimCliente"
				},
				{
					"name": "Limpieza2"
				},
				{
					"name": "LookupDimCondicionPago"
				},
				{
					"name": "Limpieza4"
				},
				{
					"name": "LookupDimEmpleado"
				},
				{
					"name": "Limpieza5"
				},
				{
					"name": "LookupProducto"
				},
				{
					"name": "Limpieza6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          NumFactura as integer,",
				"          FechaVenta as string,",
				"          Cliente as long,",
				"          CondicionPago as long,",
				"          Producto as long,",
				"          Cantidad as integer,",
				"          PrecioUnitario as decimal(7,2),",
				"          Subtotal as decimal(7,2),",
				"          precioCosto as decimal(10,2),",
				"          Costototal as decimal(21,2),",
				"          Utilidad as decimal(22,2),",
				"          Empleado as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT     df.id,\\n          f.NumFactura,\\n          f.Fecha AS FechaVenta,\\n          f.ClienteId_id AS Cliente,\\n          f.condicionId_id AS CondicionPago,\\n          dc.DetalleProductoId_id AS Producto,\\n          df.Cantidad,\\n          df.PrecioUnitario,\\n          df.Subtotal,\\n          rp.precioCosto,\\n          (df.Cantidad * rp.precioCosto) AS Costototal,\\n          (df.Subtotal - (df.Cantidad * rp.precioCosto)) AS Utilidad,\\n          tc.EmpleadoId_id AS Empleado\\n          \\n\\nFROM factura_facturas AS f\\n\\nINNER JOIN factura_detallefactura AS df ON f.id = df.FacturaId_id\\nINNER JOIN producto_registroproducto AS rp ON df.loteId_id = rp.id\\nINNER JOIN compra_detallecompra AS dc ON rp.DetalleCompraId_id = dc.id\\nINNER JOIN producto_detalleproductos AS dp ON dc.DetalleProductoId_id = dp.id\\nLEFT JOIN dbo.factura_facturascredito AS fc ON fc.FacturaId_id = F.id\\nOUTER APPLY \\n(\\n     SELECT TOP 1\\n          tc1.EmpleadoId_id\\n     FROM caja_movimientocaja AS mc\\n     INNER JOIN caja_turnocaja AS tc1 ON mc.turnoCajaId_id = tc1.id\\n     WHERE mc.facturaid_id = f.id OR mc.facturaCreditoId_id = fc.id\\n     ORDER BY \\n     CASE\\n            WHEN MC.facturaCreditoId_id = FC.id THEN 0\\n            ELSE 1\\n        END,\\n          mc.id\\n) AS tc',",
				"     format: 'query') ~> FactVenta",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          ClienteID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCliente",
				"source(output(",
				"          id as long,",
				"          CondicionPago as string,",
				"          CondicionID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCondicionPago",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          EmpleadoID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimEmpleado",
				"source(output(",
				"          id as long,",
				"          Producto as string,",
				"          Categoria as string,",
				"          MarcaProducto as string,",
				"          Moto as string,",
				"          MarcaMoto as string,",
				"          Color as string,",
				"          {Tamaño} as string,",
				"          ProductoID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimProducto",
				"FactVenta cast(output(",
				"          id as integer,",
				"          FechaVenta as date,",
				"          Cliente as integer,",
				"          CondicionPago as integer,",
				"          Producto as integer,",
				"          Empleado as integer",
				"     ),",
				"     errors: true) ~> DataConversion",
				"DataConversion, DimTiempo lookup(FechaVenta == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimTiempo",
				"LookupDimTiempo select(mapColumn(",
				"          id = DataConversion@id,",
				"          NumFactura,",
				"          Cliente,",
				"          CondicionPago,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          precioCosto,",
				"          Costototal,",
				"          Utilidad,",
				"          Empleado,",
				"          idTiempo = DimTiempo@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza1",
				"Limpieza1, DimCliente lookup(Cliente == ClienteID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimCliente",
				"LookupDimCliente select(mapColumn(",
				"          id = Limpieza1@id,",
				"          NumFactura,",
				"          Cliente,",
				"          CondicionPago,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          precioCosto,",
				"          Costototal,",
				"          Utilidad,",
				"          Empleado,",
				"          idTiempo,",
				"          idCliente = DimCliente@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza2",
				"Limpieza2, DimCondicionPago lookup(Limpieza2@CondicionPago == CondicionID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimCondicionPago",
				"LookupDimCondicionPago select(mapColumn(",
				"          id = Limpieza2@id,",
				"          NumFactura,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          precioCosto,",
				"          Costototal,",
				"          Utilidad,",
				"          Empleado,",
				"          idTiempo,",
				"          idCliente,",
				"          idCondicionPago = DimCondicionPago@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza4",
				"Limpieza4, DimEmpleado lookup(Empleado == EmpleadoID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimEmpleado",
				"LookupDimEmpleado select(mapColumn(",
				"          id = Limpieza4@id,",
				"          NumFactura,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          precioCosto,",
				"          Costototal,",
				"          Utilidad,",
				"          idTiempo,",
				"          idCliente,",
				"          idCondicionPago,",
				"          idEmpleado = DimEmpleado@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza5",
				"Limpieza5, DimProducto lookup(Limpieza5@Producto == ProductoID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupProducto",
				"LookupProducto select(mapColumn(",
				"          id = Limpieza5@id,",
				"          NumFactura,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          precioCosto,",
				"          Costototal,",
				"          Utilidad,",
				"          idTiempo,",
				"          idCliente,",
				"          idCondicionPago,",
				"          idEmpleado,",
				"          idProducto = DimProducto@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza6",
				"Limpieza6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          NumFactura as integer,",
				"          Cantidad as integer,",
				"          PrecioUnitario as decimal(10,2),",
				"          Subtotal as decimal(10,2),",
				"          CostoTotal as decimal(10,2),",
				"          Utilidad as decimal(10,2),",
				"          idTiempo as long,",
				"          idProducto as long,",
				"          idEmpleado as long,",
				"          idCliente as long,",
				"          idCondicionPago as long,",
				"          VentaID as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VentaID = id,",
				"          NumFactura,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          CostoTotal = Costototal,",
				"          Utilidad,",
				"          idTiempo,",
				"          idProducto,",
				"          idEmpleado,",
				"          idCliente,",
				"          idCondicionPago",
				"     )) ~> DestinoFactVenta"
			]
		}
	}
}