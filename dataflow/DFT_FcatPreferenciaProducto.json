{
	"name": "DFT_FcatPreferenciaProducto",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "TBL_TEMP_Encuesta",
						"type": "DatasetReference"
					},
					"name": "FactPreferenciaProducto"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo"
				},
				{
					"dataset": {
						"referenceName": "D_DimCliente",
						"type": "DatasetReference"
					},
					"name": "DimCliente"
				},
				{
					"dataset": {
						"referenceName": "D_DimPreferenciaProducto",
						"type": "DatasetReference"
					},
					"name": "DimPreferenciaProducto"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "D_FactPreferenciaProducto",
						"type": "DatasetReference"
					},
					"name": "DestinoFactPreferenciaProducto"
				}
			],
			"transformations": [
				{
					"name": "DataConversion"
				},
				{
					"name": "lookupTiempo"
				},
				{
					"name": "Limpieza"
				},
				{
					"name": "lookupCliente"
				},
				{
					"name": "lookupProductoPreferido"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "Limpieza2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ObjectId as string,",
				"          ClienteID as string,",
				"          FechaEncuesta as string,",
				"          ProductosFrecuentes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    ObjectId,\\n    ClienteID,\\n    CONVERT(VARCHAR(10),\\n        TRY_CONVERT(DATETIME2, FechaEncuesta), 23\\n    ) AS FechaEncuesta,\\n    ProductosFrecuentes\\nFROM dbo.StgEncuestaSatisfaccion',",
				"     format: 'query') ~> FactPreferenciaProducto",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          ClienteID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCliente",
				"source(output(",
				"          id as long,",
				"          NombreProducto as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimPreferenciaProducto",
				"FactPreferenciaProducto cast(output(",
				"          ClienteID as integer,",
				"          FechaEncuesta as date",
				"     ),",
				"     errors: true) ~> DataConversion",
				"DataConversion, DimTiempo lookup(FechaEncuesta == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupTiempo",
				"lookupTiempo select(mapColumn(",
				"          ObjectId,",
				"          ClienteID,",
				"          ProductosFrecuentes,",
				"          idTiempo = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza",
				"Limpieza, DimCliente lookup(Limpieza@ClienteID == DimCliente@ClienteID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCliente",
				"lookupCliente, DimPreferenciaProducto lookup(ProductosFrecuentes == NombreProducto,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupProductoPreferido",
				"lookupProductoPreferido derive(CantidadMension = toInteger(1)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          ObjectId,",
				"          idTiempo,",
				"          idCliente = DimCliente@id,",
				"          idPreferenciaProducto = DimPreferenciaProducto@id,",
				"          CantidadMension",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza2",
				"Limpieza2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          CantidadMension as integer,",
				"          EncuestaID as string,",
				"          idProductoPreferido as long,",
				"          idCliente as long,",
				"          idTiempo as long",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CantidadMension,",
				"          EncuestaID = ObjectId,",
				"          idProductoPreferido = idPreferenciaProducto,",
				"          idCliente,",
				"          idTiempo",
				"     )) ~> DestinoFactPreferenciaProducto"
			]
		}
	}
}