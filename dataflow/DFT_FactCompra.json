{
	"name": "DFT_FactCompra",
	"properties": {
		"description": "Flujo de datos de la FactCompra",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "O_FactCompra",
						"type": "DatasetReference"
					},
					"name": "FactCompra"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo",
					"description": "Traer los datos que están en la dimensión Tiempo"
				},
				{
					"dataset": {
						"referenceName": "D_DimProveedor",
						"type": "DatasetReference"
					},
					"name": "DimProveedor",
					"description": "Traer la dimensión Proveedor"
				},
				{
					"dataset": {
						"referenceName": "D_DimCondicionPago",
						"type": "DatasetReference"
					},
					"name": "DimCondicionPago"
				},
				{
					"dataset": {
						"referenceName": "D_DimProducto",
						"type": "DatasetReference"
					},
					"name": "DimProducto"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DestinoFactCompra",
						"type": "DatasetReference"
					},
					"name": "DestinoFactCompra"
				}
			],
			"transformations": [
				{
					"name": "ConversionDatos"
				},
				{
					"name": "LookupDimTiempo",
					"description": "Comparar los datos de origen con la dimensión Tiempo"
				},
				{
					"name": "LookupDimProveedor",
					"description": "Comparar los datos de origen con la dimensión Tiempo"
				},
				{
					"name": "Limpieza1"
				},
				{
					"name": "Limpieza2"
				},
				{
					"name": "LookupDinCondicionPago"
				},
				{
					"name": "Limpieza3"
				},
				{
					"name": "LookupDimProducto"
				},
				{
					"name": "Limpieza4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          CompraID as long,",
				"          FechaCompra as date,",
				"          NumeroCompra as string,",
				"          Proveedor as long,",
				"          Producto as long,",
				"          Cantidad as integer,",
				"          PrecioUnitario as decimal(7,2),",
				"          Subtotal as decimal(7,2),",
				"          CondicionPago as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select  dc.id,\\n                                     c.id AS CompraID,\\n          c.Fecha AS FechaCompra,\\n          c.NumCompra AS NumeroCompra,\\n          c.ProveedorId_id AS Proveedor,\\n          dc.DetalleProductoId_id AS Producto,\\n          dc.Cantidad AS Cantidad,\\n          dc.PrecioUnitario AS PrecioUnitario,\\n          dc.Subtotal,\\n          c.CondicionPagoId_id AS CondicionPago\\n          \\n\\nfrom compra_compras AS c\\nINNER JOIN compra_detallecompra AS dc ON c.id = dc.CompraId_id\\nINNER JOIN condicionPago_condicionpago AS cp ON c.CondicionPagoId_id = cp.id\\nINNER JOIN proveedor_proveedores AS p ON c.ProveedorId_id = p.id\\nINNER JOIN producto_detalleproductos as dp ON dc.DetalleProductoId_id = dp.id',",
				"     format: 'query') ~> FactCompra",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"source(output(",
				"          id as long,",
				"          Nombre as string,",
				"          ProveedorID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimProveedor",
				"source(output(",
				"          id as long,",
				"          CondicionPago as string,",
				"          CondicionID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCondicionPago",
				"source(output(",
				"          id as long,",
				"          Producto as string,",
				"          Categoria as string,",
				"          MarcaProducto as string,",
				"          Moto as string,",
				"          MarcaMoto as string,",
				"          Color as string,",
				"          {Tamaño} as string,",
				"          ProductoID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimProducto",
				"FactCompra cast(output(",
				"          id as integer,",
				"          Proveedor as integer,",
				"          Producto as integer,",
				"          CondicionPago as integer",
				"     ),",
				"     errors: true) ~> ConversionDatos",
				"ConversionDatos, DimTiempo lookup(FechaCompra == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimTiempo",
				"Limpieza1, DimProveedor lookup(Proveedor == ProveedorID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimProveedor",
				"LookupDimTiempo select(mapColumn(",
				"          id = ConversionDatos@id,",
				"          NumeroCompra,",
				"          Proveedor,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          CondicionPago,",
				"          idTiempo = DimTiempo@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza1",
				"LookupDimProveedor select(mapColumn(",
				"          id = Limpieza1@id,",
				"          NumeroCompra,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          CondicionPago,",
				"          idTiempo,",
				"          idProveedor = DimProveedor@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza2",
				"Limpieza2, DimCondicionPago lookup(Limpieza2@CondicionPago == CondicionID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDinCondicionPago",
				"LookupDinCondicionPago select(mapColumn(",
				"          id = Limpieza2@id,",
				"          NumeroCompra,",
				"          Producto,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          idTiempo,",
				"          idProveedor,",
				"          idCondicionPago = DimCondicionPago@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza3",
				"Limpieza3, DimProducto lookup(Limpieza3@Producto == ProductoID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimProducto",
				"LookupDimProducto select(mapColumn(",
				"          id = Limpieza3@id,",
				"          NumeroCompra,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          idTiempo,",
				"          idProveedor,",
				"          idCondicionPago,",
				"          idProducto = DimProducto@id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza4",
				"Limpieza4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          NumCompra as string,",
				"          Cantidad as integer,",
				"          PrecioUnitario as decimal(10,2),",
				"          Subtotal as decimal(10,2),",
				"          idTiempo as long,",
				"          idProducto as long,",
				"          idCondicionPago as long,",
				"          idProveedor as long,",
				"          CompraID as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          NumCompra = NumeroCompra,",
				"          Cantidad,",
				"          PrecioUnitario,",
				"          Subtotal,",
				"          idTiempo,",
				"          idProveedor,",
				"          idCondicionPago,",
				"          idProducto,",
				"          CompraID = id",
				"     )) ~> DestinoFactCompra"
			]
		}
	}
}