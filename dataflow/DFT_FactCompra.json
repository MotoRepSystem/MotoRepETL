{
	"name": "DFT_FactCompra",
	"properties": {
		"description": "Flujo de datos de la FactCompra",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "O_FactCompra",
						"type": "DatasetReference"
					},
					"name": "FactCompra"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo",
					"description": "Traer los datos que están en la dimensión Tiempo"
				},
				{
					"dataset": {
						"referenceName": "D_DimProveedor",
						"type": "DatasetReference"
					},
					"name": "DimProveedor",
					"description": "Traer la dimensión Proveedor"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "ConversionDatos"
				},
				{
					"name": "LookupDimTiempo",
					"description": "Comparar los datos de origen con la dimensión Tiempo"
				},
				{
					"name": "lookupDimProveedor",
					"description": "Comparar los datos de origen con la dimensión Tiempo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          CompraID as long,",
				"          FechaCompra as date,",
				"          NumeroCompra as string,",
				"          Proveedor as long,",
				"          Producto as long,",
				"          Cantidad as integer,",
				"          PrecioUnitario as decimal(7,2),",
				"          Subtotal as decimal(7,2),",
				"          CondicionPago as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select  dc.id,\\n                                     c.id AS CompraID,\\n          c.Fecha AS FechaCompra,\\n          c.NumCompra AS NumeroCompra,\\n          c.ProveedorId_id AS Proveedor,\\n          dc.DetalleProductoId_id AS Producto,\\n          dc.Cantidad AS Cantidad,\\n          dc.PrecioUnitario AS PrecioUnitario,\\n          dc.Subtotal,\\n          c.CondicionPagoId_id AS CondicionPago\\n          \\n\\nfrom compra_compras AS c\\nINNER JOIN compra_detallecompra AS dc ON c.id = dc.CompraId_id\\nINNER JOIN condicionPago_condicionpago AS cp ON c.CondicionPagoId_id = cp.id\\nINNER JOIN proveedor_proveedores AS p ON c.ProveedorId_id = p.id\\nINNER JOIN producto_detalleproductos as dp ON dc.DetalleProductoId_id = dp.id',",
				"     format: 'query') ~> FactCompra",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"source(output(",
				"          id as long,",
				"          Nombre as string,",
				"          ProveedorID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimProveedor",
				"FactCompra cast(output(",
				"          id as integer,",
				"          Proveedor as integer,",
				"          Producto as integer,",
				"          CondicionPago as integer",
				"     ),",
				"     errors: true) ~> ConversionDatos",
				"ConversionDatos, DimTiempo lookup(FechaCompra == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimTiempo",
				"LookupDimTiempo, DimProveedor lookup(Proveedor == ProveedorID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupDimProveedor"
			]
		}
	}
}