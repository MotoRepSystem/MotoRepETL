{
	"name": "DFT_FactEncuesta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "TBL_TEMP_Encuesta",
						"type": "DatasetReference"
					},
					"name": "FactEncuesta"
				},
				{
					"dataset": {
						"referenceName": "D_DimCliente",
						"type": "DatasetReference"
					},
					"name": "DimCiente"
				},
				{
					"dataset": {
						"referenceName": "D_PreferenciaMarca",
						"type": "DatasetReference"
					},
					"name": "DimPreferenciaMarca"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "D_FactEncuesta",
						"type": "DatasetReference"
					},
					"name": "DestinoFactEncuesta"
				}
			],
			"transformations": [
				{
					"name": "DataConversion"
				},
				{
					"name": "lookupCliente"
				},
				{
					"name": "Limpieza"
				},
				{
					"name": "lookupPreferenciaMarca"
				},
				{
					"name": "Limpieza2"
				},
				{
					"name": "lookupTiempo"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "Limpieza3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ObjectId as string,",
				"          ClienteID as string,",
				"          FechaEncuesta as string,",
				"          SatisfaccionGeneral as string,",
				"          AtencionPersonal as string,",
				"          ExperienciaCompra as string,",
				"          FacilidadEncontrar as string,",
				"          VariedadProductos as string,",
				"          MarcaPreferida as string,",
				"          ComentarioServicio as string,",
				"          ComentarioMejora as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    ObjectId,\\n    ClienteID,\\n    CONVERT(VARCHAR(10), TRY_CONVERT(DATETIME2, FechaEncuesta), 23) AS FechaEncuesta,\\n    SatisfaccionGeneral,\\n    AtencionPersonal,\\n    ExperienciaCompra,\\n    FacilidadEncontrar,\\n    VariedadProductos,\\n    MarcaPreferida,\\n    ComentarioServicio,\\n    ComentarioMejora\\nFROM dbo.StgEncuestaSatisfaccion',",
				"     format: 'query') ~> FactEncuesta",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          ClienteID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCiente",
				"source(output(",
				"          id as long,",
				"          Marcas as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimPreferenciaMarca",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"FactEncuesta cast(output(",
				"          ObjectId as string,",
				"          ClienteID as integer,",
				"          FechaEncuesta as date,",
				"          SatisfaccionGeneral as integer,",
				"          AtencionPersonal as integer,",
				"          ExperienciaCompra as integer,",
				"          FacilidadEncontrar as integer,",
				"          VariedadProductos as integer",
				"     ),",
				"     errors: true) ~> DataConversion",
				"DataConversion, DimCiente lookup(DataConversion@ClienteID == DimCiente@ClienteID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCliente",
				"lookupCliente select(mapColumn(",
				"          ObjectId,",
				"          FechaEncuesta,",
				"          SatisfaccionGeneral,",
				"          AtencionPersonal,",
				"          ExperienciaCompra,",
				"          FacilidadEncontrar,",
				"          VariedadProductos,",
				"          MarcaPreferida,",
				"          ComentarioServicio,",
				"          ComentarioMejora,",
				"          idCliente = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza",
				"Limpieza, DimPreferenciaMarca lookup(MarcaPreferida == Marcas,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupPreferenciaMarca",
				"lookupPreferenciaMarca select(mapColumn(",
				"          ObjectId,",
				"          FechaEncuesta,",
				"          SatisfaccionGeneral,",
				"          AtencionPersonal,",
				"          ExperienciaCompra,",
				"          FacilidadEncontrar,",
				"          VariedadProductos,",
				"          ComentarioServicio,",
				"          ComentarioMejora,",
				"          idCliente,",
				"          idMarcaPreferida = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza2",
				"Limpieza2, DimTiempo lookup(FechaEncuesta == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupTiempo",
				"lookupTiempo derive(CantidadComentarioServicio = iif(isNull(ComentarioServicio), 0, iif(length(trim(toString(ComentarioServicio))) == 0, 0, 1)),",
				"          CantidadComentarioMejora = iif(isNull(ComentarioMejora), 0, iif(length(trim(toString(ComentarioMejora))) == 0, 0, 1))) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          ObjectId,",
				"          SatisfaccionGeneral,",
				"          AtencionPersonal,",
				"          ExperienciaCompra,",
				"          FacilidadEncontrar,",
				"          VariedadProductos,",
				"          idCliente,",
				"          idMarcaPreferida,",
				"          idTiempo = id,",
				"          CantidadComentarioServicio,",
				"          CantidadComentarioMejora",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza3",
				"Limpieza3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          SatisfaccionGeneral as integer,",
				"          AtencionPersonal as integer,",
				"          Experiencia as integer,",
				"          FacilidadEncontrarProductos as integer,",
				"          VariedadProductos as integer,",
				"          CantidadComentarioServicio as integer,",
				"          CantidadComentarioMejora as integer,",
				"          EncuestaID as string,",
				"          idPreferenciaMarca as long,",
				"          idCliente as long,",
				"          idTiempo as long",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          SatisfaccionGeneral,",
				"          AtencionPersonal,",
				"          Experiencia = ExperienciaCompra,",
				"          FacilidadEncontrarProductos = FacilidadEncontrar,",
				"          VariedadProductos,",
				"          CantidadComentarioServicio,",
				"          CantidadComentarioMejora,",
				"          EncuestaID = ObjectId,",
				"          idPreferenciaMarca = idMarcaPreferida,",
				"          idCliente,",
				"          idTiempo",
				"     )) ~> DestinoFactEncuesta"
			]
		}
	}
}