{
	"name": "DFT_FactIncidencia",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "TBL_TEMP_Incidencia",
						"type": "DatasetReference"
					},
					"name": "FactIncidencia"
				},
				{
					"dataset": {
						"referenceName": "D_DimTiempo",
						"type": "DatasetReference"
					},
					"name": "DimTiempo"
				},
				{
					"dataset": {
						"referenceName": "O_TipoIncidencia",
						"type": "DatasetReference"
					},
					"name": "DimTipoIncidencia"
				},
				{
					"dataset": {
						"referenceName": "O_DimDetalleIncidencia",
						"type": "DatasetReference"
					},
					"name": "DimDetalleIncidencia"
				},
				{
					"dataset": {
						"referenceName": "O_DimOrigenIncidencia",
						"type": "DatasetReference"
					},
					"name": "DimOrigenIncidencia"
				},
				{
					"dataset": {
						"referenceName": "D_DimEmpleado",
						"type": "DatasetReference"
					},
					"name": "DimEmpleado"
				},
				{
					"dataset": {
						"referenceName": "D_DimCliente",
						"type": "DatasetReference"
					},
					"name": "DimCliente"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "D_FactIncidencia",
						"type": "DatasetReference"
					},
					"name": "DestinoFactIncidencia"
				}
			],
			"transformations": [
				{
					"name": "DataConversion"
				},
				{
					"name": "lookupTiempo"
				},
				{
					"name": "Limpieza1"
				},
				{
					"name": "lookupTipoIncidencia"
				},
				{
					"name": "Limpieza2"
				},
				{
					"name": "lookupDetalleIncidencia"
				},
				{
					"name": "Limpieza3"
				},
				{
					"name": "lookupOrigenIncidencia"
				},
				{
					"name": "Limpieza4"
				},
				{
					"name": "lookupEmpleado"
				},
				{
					"name": "Limpieza5"
				},
				{
					"name": "lookupCliente"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "Limpieza6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ObjectId as string,",
				"          FechaRegistro as string,",
				"          TipoIncidencia as string,",
				"          OrigenTipo as string,",
				"          ClienteID as integer,",
				"          Descripcion as string,",
				"          MontoInvolucrado as decimal(10,2),",
				"          EmpleadoID as string,",
				"          Prioridad as string,",
				"          EvidenciaURL as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    ObjectId,\\n    CONVERT(\\n        VARCHAR(10),\\n        TRY_CONVERT(DATETIME2, FechaRegistro),\\n        23\\n    ) AS FechaRegistro,\\n    TipoIncidencia,\\n    OrigenTipo,\\n    TRY_CONVERT(INT, NULLIF(LTRIM(RTRIM(ClienteID)), \\'\\')) AS ClienteID,\\n    Descripcion,\\n    TRY_CONVERT(DECIMAL(10,2), MontoInvolucrado) AS MontoInvolucrado,\\n    EmpleadoID,\\n    Prioridad,\\n    EvidenciaURL\\nFROM dbo.StgIncidencias',",
				"     format: 'query') ~> FactIncidencia",
				"source(output(",
				"          id as long,",
				"          Fecha as date,",
				"          Dia as integer,",
				"          Mes as integer,",
				"          Year as integer,",
				"          Trimestre as string,",
				"          NombreDia as string,",
				"          NombreMes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTiempo",
				"source(output(",
				"          id as long,",
				"          TipoDescripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimTipoIncidencia",
				"source(output(",
				"          id as long,",
				"          CategoriaIncidencia as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimDetalleIncidencia",
				"source(output(",
				"          id as long,",
				"          Origen as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimOrigenIncidencia",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          EmpleadoID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimEmpleado",
				"source(output(",
				"          id as long,",
				"          NombreCompleto as string,",
				"          ClienteID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimCliente",
				"FactIncidencia cast(output(",
				"          FechaRegistro as date,",
				"          EmpleadoID as integer,",
				"          Prioridad as integer",
				"     ),",
				"     errors: true) ~> DataConversion",
				"DataConversion, DimTiempo lookup(FechaRegistro == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupTiempo",
				"lookupTiempo select(mapColumn(",
				"          ObjectId,",
				"          TipoIncidencia,",
				"          OrigenTipo,",
				"          ClienteID,",
				"          Descripcion,",
				"          MontoInvolucrado,",
				"          EmpleadoID,",
				"          Prioridad,",
				"          EvidenciaURL,",
				"          idTiempo = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza1",
				"Limpieza1, DimTipoIncidencia lookup(TipoIncidencia == TipoDescripcion,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupTipoIncidencia",
				"lookupTipoIncidencia select(mapColumn(",
				"          ObjectId,",
				"          OrigenTipo,",
				"          ClienteID,",
				"          Descripcion,",
				"          MontoInvolucrado,",
				"          EmpleadoID,",
				"          Prioridad,",
				"          EvidenciaURL,",
				"          idTiempo,",
				"          idTipoIncidencia = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza2",
				"Limpieza2, DimDetalleIncidencia lookup(Limpieza2@Descripcion == DimDetalleIncidencia@Descripcion,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupDetalleIncidencia",
				"lookupDetalleIncidencia select(mapColumn(",
				"          ObjectId,",
				"          OrigenTipo,",
				"          ClienteID,",
				"          MontoInvolucrado,",
				"          EmpleadoID,",
				"          Prioridad,",
				"          EvidenciaURL,",
				"          idTiempo,",
				"          idTipoIncidencia,",
				"          idDetalleIncidencia = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza3",
				"Limpieza3, DimOrigenIncidencia lookup(OrigenTipo == Origen,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupOrigenIncidencia",
				"lookupOrigenIncidencia select(mapColumn(",
				"          ObjectId,",
				"          ClienteID,",
				"          MontoInvolucrado,",
				"          EmpleadoID,",
				"          Prioridad,",
				"          EvidenciaURL,",
				"          idTiempo,",
				"          idTipoIncidencia,",
				"          idDetalleIncidencia,",
				"          idOrigenIncidencia = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza4",
				"Limpieza4, DimEmpleado lookup(Limpieza4@EmpleadoID == DimEmpleado@EmpleadoID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupEmpleado",
				"lookupEmpleado select(mapColumn(",
				"          ObjectId,",
				"          ClienteID,",
				"          MontoInvolucrado,",
				"          Prioridad,",
				"          EvidenciaURL,",
				"          idTiempo,",
				"          idTipoIncidencia,",
				"          idDetalleIncidencia,",
				"          idOrigenIncidencia,",
				"          idEmpleado = id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza5",
				"Limpieza5, DimCliente lookup(Limpieza5@ClienteID == DimCliente@ClienteID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCliente",
				"lookupCliente derive(TieneEvidencia = iif(isNull(EvidenciaURL), 0, iif(length(toString(EvidenciaURL)) == 0, 0, 1))) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          ObjectId,",
				"          MontoInvolucrado,",
				"          Prioridad,",
				"          idTiempo,",
				"          idTipoIncidencia,",
				"          idDetalleIncidencia,",
				"          idOrigenIncidencia,",
				"          idEmpleado,",
				"          idCliente = id,",
				"          TieneEvidencia",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Limpieza6",
				"Limpieza6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as long,",
				"          MontoInvolucrado as decimal(10,2),",
				"          Prioridad as integer,",
				"          TieneEvidencia as integer,",
				"          IncidenciaID as string,",
				"          idTipoIncidencia as long,",
				"          idDetalleIncidencia as long,",
				"          idCliente as long,",
				"          idEmpleado as long,",
				"          idTiempo as long,",
				"          idOrigenIncidencia as long",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          MontoInvolucrado,",
				"          Prioridad,",
				"          TieneEvidencia,",
				"          IncidenciaID = ObjectId,",
				"          idTipoIncidencia,",
				"          idDetalleIncidencia,",
				"          idCliente,",
				"          idEmpleado,",
				"          idTiempo,",
				"          idOrigenIncidencia",
				"     )) ~> DestinoFactIncidencia"
			]
		}
	}
}